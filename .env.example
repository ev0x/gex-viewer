# Required for the MenthorQ source (https://menthorq.io). Leave empty to disable
# that mode — the GEX API source still works without it.
MENTHORQ_API_KEY=

# Sent as the user_id query param. Any non-empty string is accepted upstream.
MENTHORQ_USER_ID=gex-viewer

# Discord webhook for the daily post_daily.py job. Create one under a channel's
# Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# Optional: URL post_daily.py fetches (default http://localhost:5181/daily?format=txt)
# DAILY_URL=http://localhost:5181/daily?format=txt
# Optional: override the webhook's display name in Discord
# DISCORD_USERNAME=GEX Levels
